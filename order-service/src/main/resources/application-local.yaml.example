server:
  port: 8085

spring:
  datasource:
    url: jdbc:postgresql://localhost:5436/order_db
    username: postgres
    password: postgres
    driver-class-name: org.postgresql.Driver

  kafka:
    bootstrap-servers: localhost:9092

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
    open-in-view: false

jwt:
  secret: VGhpcy1pcy1hLWxvY2FsLWRldmVsb3BtZW50LWp3dC1zZWNyZXQta2V5LWZvci1lY29tbS1hdXRoLXNlcnZpY2U=

services:
  cart-service:
    url: http://localhost:8084
  user-service:
    url: http://localhost:8082
  product-service:
    url: http://localhost:8083